<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CATNET</title>
    <style>
        :root {
            --bg: #0a0a0c;
            --surface: #121216;
            --border: #23232a;
            --text: #e0e0e0;
            --muted: #888;
            --accent: #ff3333;
            --accent-dim: #661414;
            --green: #33ff66;
            --font: 'Courier New', Courier, monospace;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--bg);
            color: var(--text);
            font-family: var(--font);
            font-size: 14px;
            line-height: 1.5;
            display: flex;
            height: 100vh;
            overflow: hidden;
        }
        /* Sidebar */
        .sidebar {
            width: 250px;
            background-color: var(--surface);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }
        .logo {
            padding: 20px;
            font-size: 24px;
            font-weight: bold;
            color: var(--accent);
            border-bottom: 1px solid var(--border);
            letter-spacing: 2px;
            text-align: center;
        }
        .logo span { color: var(--text); font-weight: normal; font-size: 12px; display: block; letter-spacing: 1px; }
        .nav-section {
            padding: 15px 0;
            border-bottom: 1px solid var(--border);
        }
        .nav-title {
            color: var(--muted);
            font-size: 11px;
            text-transform: uppercase;
            padding: 0 20px;
            margin-bottom: 10px;
            letter-spacing: 1px;
        }
        .nav-item {
            padding: 8px 20px;
            cursor: pointer;
            transition: background 0.2s;
            display: flex;
            align-items: center;
        }
        .nav-item:hover {
            background-color: var(--border);
            color: var(--accent);
        }
        .nav-item.active {
            background-color: var(--accent-dim);
            color: var(--text);
            border-left: 3px solid var(--accent);
        }
        /* Main Content */
        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            padding: 30px;
        }
        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--border);
        }
        .header-title {
            font-size: 22px;
            color: var(--text);
        }
        .header-user {
            color: var(--muted);
            font-size: 12px;
        }
        .header-user span { color: var(--green); }
        
        /* Dashboard Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 40px;
        }
        .stat-card {
            background-color: var(--surface);
            border: 1px solid var(--border);
            padding: 20px;
            text-align: center;
        }
        .stat-card .value {
            font-size: 28px;
            color: var(--accent);
            margin-bottom: 5px;
        }
        .stat-card .label {
            font-size: 12px;
            color: var(--muted);
            text-transform: uppercase;
        }

        /* Hits Table */
        .table-container {
            background-color: var(--surface);
            border: 1px solid var(--border);
            margin-bottom: 40px;
            overflow-x: auto;
        }
        .table-header {
            padding: 15px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .table-header h3 { font-size: 16px; }
        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }
        th {
            background-color: var(--bg);
            color: var(--muted);
            font-size: 11px;
            text-transform: uppercase;
            padding: 10px 15px;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }
        td {
            padding: 15px;
            border-bottom: 1px solid var(--border);
            font-size: 13px;
            white-space: nowrap;
        }
        tr:last-child td { border-bottom: none; }
        .no-hits {
            text-align: center;
            padding: 30px;
            color: var(--muted);
        }

        /* Leaderboard */
        .leaderboard-container {
            background-color: var(--surface);
            border: 1px solid var(--border);
            margin-bottom: 40px;
        }
        .leaderboard-item {
            display: flex;
            padding: 15px;
            border-bottom: 1px solid var(--border);
            align-items: center;
        }
        .leaderboard-item:last-child { border-bottom: none; }
        .lb-rank {
            width: 40px;
            font-weight: bold;
            color: var(--muted);
        }
        .lb-rank.top { color: var(--accent); }
        .lb-user {
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        .lb-user .name { font-weight: bold; }
        .lb-user .hash { font-size: 11px; color: var(--muted); }
        .lb-value {
            color: var(--green);
            font-weight: bold;
            text-align: right;
        }

        /* Builder / Settings / Features layout */
        .panel {
            background-color: var(--surface);
            border: 1px solid var(--border);
            padding: 20px;
            margin-bottom: 20px;
        }
        .panel-title {
            font-size: 16px;
            color: var(--accent);
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border);
        }
        
        /* Builder Specific */
        .mod-card {
            background-color: var(--bg);
            border: 1px solid var(--border);
            padding: 15px;
            margin-bottom: 15px;
        }
        .mod-card h4 { color: var(--text); margin-bottom: 5px; }
        .mod-card p { font-size: 12px; color: var(--muted); margin-bottom: 10px; }
        .download-btn {
            display: inline-block;
            background-color: var(--accent-dim);
            color: var(--accent);
            padding: 8px 15px;
            text-decoration: none;
            border: 1px solid var(--accent);
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .download-btn:hover {
            background-color: var(--accent);
            color: var(--bg);
        }

        /* Settings specific */
        .setting-row {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
        }
        .setting-row label {
            flex: 1;
            font-size: 13px;
        }
        .setting-row input[type="text"] {
            flex: 1;
            background-color: var(--bg);
            border: 1px solid var(--border);
            color: var(--text);
            padding: 8px;
            font-family: var(--font);
            outline: none;
        }
        .setting-row input[type="text"]:focus {
            border-color: var(--accent);
        }
        /* Custom Toggle Switch */
        .switch {
            position: relative;
            display: inline-block;
            width: 40px;
            height: 20px;
        }
        .switch input { opacity: 0; width: 0; height: 0; }
        .slider {
            position: absolute;
            cursor: pointer;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: var(--border);
            transition: .4s;
        }
        .slider:before {
            position: absolute;
            content: "";
            height: 14px;
            width: 14px;
            left: 3px;
            bottom: 3px;
            background-color: var(--text);
            transition: .4s;
        }
        input:checked + .slider {
            background-color: var(--accent);
        }
        input:checked + .slider:before {
            transform: translateX(20px);
            background-color: var(--bg);
        }

        /* Features specific */
        ul.features-list {
            list-style: none;
        }
        ul.features-list li {
            padding: 8px 0;
            border-bottom: 1px dashed var(--border);
            font-size: 13px;
        }
        ul.features-list li:last-child { border-bottom: none; }
        ul.features-list li::before {
            content: "> ";
            color: var(--accent);
        }
        
        /* Remote specific */
        .remote-panel {
            background-color: var(--bg);
            border: 1px dashed var(--accent);
            padding: 20px;
            text-align: center;
            margin-top: 15px;
        }
        .remote-panel .id { font-family: var(--font); color: var(--green); font-size: 16px; margin: 10px 0; }

        /* Hide sections by default, JS handles visibility */
        .section { display: none; }
        .section.active { display: block; }
        
        /* Terminal log for the builder output */
        #builder-log {
            background-color: #000;
            color: var(--green);
            padding: 10px;
            border: 1px solid var(--border);
            font-size: 12px;
            margin-top: 10px;
            display: none;
            white-space: pre-wrap;
        }
    </style>
</head>
