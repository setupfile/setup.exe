    <script>
        // Navigation logic
        function showSection(sectionId) {
            // Hide all sections
            document.querySelectorAll('.section').forEach(sec => {
                sec.classList.remove('active');
            });
            // Remove active state from nav items
            document.querySelectorAll('.nav-item').forEach(nav => {
                nav.classList.remove('active');
            });
            
            // Show target section
            const targetSection = document.getElementById(sectionId);
            if (targetSection) {
                targetSection.classList.add('active');
            }

            // Highlight clicked nav item
            const clickedNav = Array.from(document.querySelectorAll('.nav-item')).find(nav => 
                nav.getAttribute('onclick') === `showSection('${sectionId}')`
            );
            if (clickedNav) {
                clickedNav.classList.add('active');
            }

            // Update page title
            const titleMap = {
                'dashboard': 'Dashboard',
                'builder': 'Builder',
                'settings': 'Settings',
                'account': 'Account',
                'features': 'Features',
                'leaderboard': 'Leaderboard',
                'remote': 'Remote Access'
            };
            document.getElementById('page-title').innerText = titleMap[sectionId] || 'CATNET';
        }

        // Builder output logic
        function generateOutput() {
            const log = document.getElementById('builder-log');
            const webhook = document.getElementById('webhook-input').value.trim();
            
            if (!webhook) {
                log.style.display = 'block';
                log.innerText = '[ERROR] Webhook URL is required to build payload.\n[SYSTEM] Aborting build process.';
                log.style.color = '#ff3333'; // Red for error
                return;
            }

            log.style.color = 'var(--green)'; // Reset color
            log.style.display = 'block';
            log.innerText = `[SYSTEM] Initializing build sequence...
[SYSTEM] Fetching payload from configured endpoint...
[SYSTEM] Injecting webhook: ${webhook.substring(0, 30)}...
[SYSTEM] Compiling executable...
[SYSTEM] Build complete. File ready for download.
Download: https://catnet-builder.local/download/catnet_payload.exe?hook=${encodeURIComponent(webhook)}`;
        }
    </script>
